# Copiez ce fichier vers .env : cp .env.example .env   (Windows : copy .env.example .env)
# Le fichier .env reste sur votre machine et n'est jamais envoye sur GitHub.

# Port du serveur
PORT=5000

# Adresse de MongoDB
# - MongoDB local ou Docker : garder la valeur ci-dessous
# - MongoDB Atlas : remplacer par votre lien mongodb+srv://...
MONGO_URI=mongodb://127.0.0.1:27017/marketplace

# Cle secrete pour signer les tokens JWT (mettez une longue phrase de votre choix)
JWT_SECRET=changez_cette_phrase_par_une_longue_cle_secrete
JWT_EXPIRES_IN=1d

# OPTIONNEL : base pour le test de parcours complet (npm run test:integration)
# ATTENTION : cette base est videe a chaque test, ne mettez JAMAIS la base normale
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/marketplace_test
